pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('CHECK WORKSPACE') {
            steps {
                sh '''
                    echo "Workspace: $WORKSPACE"
                    test -f compose/docker-compose.yml
                    echo "Docker Compose file found"
                '''
            }
        }

        stage('CHECK DOCKER') {
            steps {
                sh '''
                    docker version
                    docker compose version
                '''
            }
        }

        stage('CHECK APP IMAGE') {
            steps {
                sh '''
                    docker image inspect vprofile-app:15 \
                      --format='Image ID: {{.Id}}'
                '''
            }
        }

        stage('VALIDATE COMPOSE CONFIG') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'vprofile-compose-env',
                        variable: 'ENV_FILE'
                    )
                ]) {
                    sh '''
                        set -eu
                        test -s "$ENV_FILE"
                        docker compose \
                          --env-file "$ENV_FILE" \
                          -f compose/docker-compose.yml \
                          config --quiet
                        echo "Compose configuration validated"
                    '''
                }
            }
        }
    }
}
