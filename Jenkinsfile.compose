pipeline {
    agent any

    parameters {
        string(
            name: 'APP_IMAGE_TAG',
            defaultValue: '15',
            description: 'Existing local vprofile-app image tag'
        )
        booleanParam(
            name: 'DEPLOY',
            defaultValue: false,
            description: 'Deploy the Compose stack when explicitly enabled'
        )
    }

    options {
        timestamps()
    }

    stages {
        stage('CHECK WORKSPACE') {
            steps {
                sh '''
                    echo "Workspace: $WORKSPACE"
                    test -f compose/docker-compose.yml
                    echo "Docker Compose file found"
                '''
            }
        }

        stage('CHECK DOCKER') {
            steps {
                sh '''
                    docker version
                    docker compose version
                '''
            }
        }

        stage('CHECK APP IMAGE') {
            steps {
                sh '''
                    set -eu
                    docker image inspect "vprofile-app:${APP_IMAGE_TAG}" \
                      --format='Image ID: {{.Id}}'
                '''
            }
        }

        stage('VALIDATE COMPOSE CONFIG') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'vprofile-compose-env',
                        variable: 'ENV_FILE'
                    )
                ]) {
                    sh '''
                        set -eu
                        test -s "$ENV_FILE"
                        docker compose \
                          --env-file "$ENV_FILE" \
                          -f compose/docker-compose.yml \
                          config --quiet
                        echo "Compose configuration validated"
                    '''
                }
            }
        }

        stage('DEPLOY COMPOSE STACK') {
            when {
                expression { params.DEPLOY == true }
            }
            steps {
                withCredentials([
                    file(
                        credentialsId: 'vprofile-compose-env',
                        variable: 'ENV_FILE'
                    )
                ]) {
                    sh '''
                        set -eu
                        docker compose \
                          --env-file "$ENV_FILE" \
                          -f compose/docker-compose.yml \
                          up -d --wait
                    '''
                }
            }
        }
    }
}
